# Load with: set -a; . ./.env; set +a
# Keep this file's real copy private (chmod 600 .env); never commit it.
WOLFY_MODE=production
WOLFY_LISTEN=127.0.0.1:8080
WOLFY_DB=/var/lib/wolfy/wolfy.db
WOLFY_CONTACT='Nome e contatto del responsabile'
WOLFY_BUDGET_NANO_USD=2000000000
WOLFY_DAILY_LIMIT=20
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Choose the supported Graph API version in your Meta app dashboard.
META_GRAPH_VERSION=
GOOGLE_APPLICATION_CREDENTIALS=/etc/wolfy/google-service-account.json
GOOGLE_SHEET_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Nano-USD per token. Recheck provider prices before a live pilot.
OPENAI_INPUT_NANO_USD=750
OPENAI_OUTPUT_NANO_USD=4500
OPENAI_MAX_OUTPUT_TOKENS=500
